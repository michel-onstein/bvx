# SwiftPM
.build/
.swiftpm/
*.xcodeproj

# Go engine build output. The archive is ~25 MB and fully reproducible from
# the pinned beads_viewer version in Engine/bridge/go.mod, so it is rebuilt
# rather than committed. The generated header IS committed, because the Swift
# C target needs it to compile before the archive exists.
Engine/build/

# macOS
.DS_Store

# Python bytecode from the scripts in scripts/
__pycache__/
*.pyc

# bv's per-workspace state, written by bvx as well: the semantic search index,
# a saved baseline, drift configuration. The index is a rebuildable cache and
# the baseline is a local reference point, so neither belongs in the repository
# — but `.bv/recipes.yaml` is shared configuration and is deliberately kept.
.bv/semantic/
.bv/baseline.json

# Signing configuration. Every value in it identifies an Apple developer
# account — the Team ID, the certificate names that embed it, the notary
# credential — and this repository is public. `scripts/signing.env.example`
# is the committed template, with placeholders.
# The glob, not just the exact name: an editor leaves `signing.env~`,
# `signing.env.bak` and `.signing.env.swp` beside it, each holding the same
# buffer — the Team ID included. The exact-name rule caught the file and left
# vim's swap file untracked-but-committable, which is how this was found.
scripts/signing.env
scripts/signing.env.*
scripts/signing.env~
scripts/.signing.env*
# ...except the committed template, which the glob above would otherwise
# swallow. A test asserts this stays true in both directions.
!scripts/signing.env.example

# Provisioning profiles carry the team identifier and the certificates they
# are bound to. Configure a path to one outside the checkout; if one is copied
# in anyway, it is still not committed.
*.provisionprofile
*.mobileprovision

# Expanded entitlements and built artifacts land in .build/dist/, which is
# already covered by .build/ above. Listed here so the reason is recorded:
# the App Store entitlements are generated from a template because the real
# file has to contain the Team ID verbatim.
