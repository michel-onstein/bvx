# SwiftPM
.build/
.swiftpm/
*.xcodeproj

# Go engine build output. The archive is ~25 MB and fully reproducible from
# the pinned beads_viewer version in Engine/bridge/go.mod, so it is rebuilt
# rather than committed. The generated header IS committed, because the Swift
# C target needs it to compile before the archive exists.
Engine/build/

# macOS
.DS_Store

# bv's per-workspace state, written by bvx as well: the semantic search index,
# a saved baseline, drift configuration. The index is a rebuildable cache and
# the baseline is a local reference point, so neither belongs in the repository
# — but `.bv/recipes.yaml` is shared configuration and is deliberately kept.
.bv/semantic/
.bv/baseline.json
