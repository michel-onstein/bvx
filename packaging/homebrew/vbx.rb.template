# Homebrew cask for Visual Beads.
#
# Generated by scripts/release.sh — do not edit the rendered copy. The version
# and checksum have to match the artefact exactly, and a cask edited by hand is
# how they come to disagree with what the app reports.
#
# It lives in a personal tap rather than homebrew/homebrew-cask: that repository
# requires software with a track record, and submitting a newly published app
# costs a review cycle for a predictable no. See docs/project_notes/DECISIONS.md.
cask "vbx" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "@URL@",
      verified: "github.com/@REPO@/"
  name "Visual Beads"
  desc "Native macOS app for beads issue graphs"
  homepage "@HOMEPAGE@"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: ">= :sonoma"

  # The bundle on disk is vbx.app — `vbx` is the short form that names the
  # executable, the bundle identifier and the URL scheme. Finder shows it as
  # "Visual Beads" from CFBundleDisplayName.
  app "vbx.app"

  # `brew install --cask vbx` does not put the CLI on the PATH by itself: it is
  # bundled inside the app, mirroring how Xcode ships xcodebuild.
  binary "#{appdir}/vbx.app/Contents/MacOS/vbx-cli", target: "vbx-cli"

  zap trash: [
    # The column layout and the recent-workspaces list.
    "~/Library/Preferences/com.qjam.vbx.plist",
    "~/Library/Saved Application State/com.qjam.vbx.savedState",
    "~/Library/Caches/com.qjam.vbx",
    "~/Library/HTTPStorages/com.qjam.vbx",
  ]

  caveats <<~EOS
    Deploy credentials are kept in the Keychain, which `--zap` cannot reach.
    To remove them:

      security delete-generic-password -s com.qjam.vbx -a github-token
      security delete-generic-password -s com.qjam.vbx -a cloudflare-token
  EOS
end
